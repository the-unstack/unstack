
# Postgres (Timescale)
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=unifiednamespace
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASS=grafana

# Grafana
GRAFANA_SECURITY_ADMIN_USER=admin
GRAFANA_SECURITY_ADMIN_PASSWORD=password

# Optional: override the monitor's Docker socket for rootless Podman.
# CONTAINER_SOCKET=/run/user/1000/podman/podman.sock
